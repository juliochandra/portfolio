// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  username     String @unique @db.VarChar(50)
  passwordHash String
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Project {
  id             String        @id @default(cuid())
  title          String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(220)
  description    String?       @db.VarChar(300)
  content        String        @db.Text
  demoUrl        String?       @db.VarChar(255)
  repositoryUrl  String?       @db.VarChar(255)
  thumbnailImage String?       @db.VarChar(255)
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags   Tag[]
  skills Skill[]

  @@index([slug])
  @@index([status, publishedAt])
}

model Post {
  id             String        @id @default(cuid())
  title          String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(220)
  description    String?       @db.VarChar(300)
  content        String        @db.Text
  readingTime    Int
  thumbnailImage String?       @db.VarChar(255)
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags Tag[]

  @@index([slug])
  @@index([status, publishedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(60)
  createdAt DateTime @default(now())

  posts    Post[]
  projects Project[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  slug      String   @unique @db.VarChar(60)
  icon      String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  projects Project[]
}

model Media {
  id        String   @id @default(cuid())
  fileName  String   @db.VarChar(255)
  objectKey String   @unique @db.VarChar(255)
  url       String   @db.VarChar(500)
  mimeType  String   @db.VarChar(100)
  extension String   @db.VarChar(20)
  size      Int
  createdAt DateTime @default(now())
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())

  media Media[]
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model Message {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(255)
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model ContactInfo {
  id    String  @id @default(cuid())
  label String  @db.VarChar(100)
  value String  @db.VarChar(255)
  icon  String? @db.VarChar(100)
}
