// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

model Project {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String?
  content        String
  demoUrl        String?
  repositoryUrl  String?
  thumbnailImage String?
  status         String        @default("DRAFT")
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags   Tag[]
  skills Skill[]

  @@index([slug])
  @@index([status, publishedAt])
}

model Post {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String?
  content        String
  readingTime    Int
  thumbnailImage String?
  status         String        @default("DRAFT")
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags Tag[]

  @@index([slug])
  @@index([status, publishedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts    Post[]
  projects Project[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  projects Project[]
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  objectKey String   @unique
  url       String
  mimeType  String
  extension String
  size      Int
  createdAt DateTime @default(now())
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  media Media[]
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String
  status    String        @default("UNREAD")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model ContactInfo {
  id    String  @id @default(cuid())
  label String
  value String
  icon  String?
}
