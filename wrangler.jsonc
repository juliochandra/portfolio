{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "./worker.ts",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-07-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "julio.my.id",
			"zone_name": "julio.my.id",
			"custom_domain": true
		},
		{
			"pattern": "www.julio.my.id/*",
			"zone_name": "julio.my.id"
		}
	],
	"triggers": {
		"crons": ["0 2 * * *"]
	},
	"d1_databases": [
		{
			"binding": "portfolio_db",
			"database_name": "portfolio-db",
			"database_id": "a9deffb9-419d-460e-9ac5-bdb936b4ad17",
			"migrations_dir": "prisma/migrations",
			"migrations_pattern": "prisma/migrations/*/migration.sql",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "PORTFOLIO_MEDIA",
			"bucket_name": "portfolio",
			"remote": true
		}
	]
}
