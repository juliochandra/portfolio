{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "prisma generate",
		"dev": "next dev --turbopack",
		"build": "opennextjs-cloudflare build",
		"next:build": "next build --turbopack",
		"cf-typegen": "wrangler types cloudflare-env.d.ts",
		"cf:build": "npm run build",
		"cf:deploy": "opennextjs-cloudflare deploy",
		"d1:migrate:local": "wrangler d1 migrations apply portfolio --local",
		"d1:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
		"d1:seed": "node --env-file=.env prisma/seed.mts",
		"d1:seed:local": "node --env-file=.env prisma/seed.mts --local",
		"deploy": "npm run build && npm run cf:deploy",
		"preview": "npm run cf:build && opennextjs-cloudflare preview",
		"start": "next start",
		"lint": "biome check",
		"format": "biome format --write",
		"format-unsafe": "biome check --write --unsafe",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.11",
		"@prisma/adapter-d1": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@tiptap/core": "^3.28.0",
		"@tiptap/extension-color": "^3.28.0",
		"@tiptap/extension-highlight": "^3.28.0",
		"@tiptap/extension-image": "^3.28.0",
		"@tiptap/extension-link": "^3.28.0",
		"@tiptap/extension-subscript": "^3.28.0",
		"@tiptap/extension-superscript": "^3.28.0",
		"@tiptap/extension-text-align": "^3.28.0",
		"@tiptap/extension-text-style": "^3.28.0",
		"@tiptap/extension-underline": "^3.28.0",
		"@tiptap/pm": "^3.28.0",
		"@tiptap/react": "^3.28.0",
		"@tiptap/starter-kit": "^3.28.0",
		"bcryptjs": "^3.0.3",
		"jsonwebtoken": "^9.0.3",
		"next": "15.5.20",
		"prisma": "^7.8.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.81.0",
		"react-icons": "^5.7.0",
		"react-toastify": "^11.0.3",
		"sanitize-html": "^2.17.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/sanitize-html": "^2.16.1",
		"@vitejs/plugin-react": "^6.0.3",
		"dotenv": "^17.4.2",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.10",
		"wrangler": "^4.65.0"
	}
}
