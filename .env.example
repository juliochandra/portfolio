# Cloudflare R2 public URL. Bucket runtime diakses lewat binding PORTFOLIO_MEDIA.
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Akun admin awal (dipakai sekali oleh prisma/seed.ts, bukan nilai produksi — ganti lewat SCR-19 setelah ISS-012).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-after-first-login"

# Opsional. Nama database D1; default-nya `portfolio`.
D1_DATABASE_NAME="portfolio"

# JWT sesi admin — gunakan nilai acak yang berbeda untuk access dan refresh.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
